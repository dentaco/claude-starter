{
  "model": "opus",
  "effortLevel": "medium",
  "permissions": { "defaultMode": "default" },
  "attribution": { "commit": "" },
  "tui": "fullscreen",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMemoryEnabled": true,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "statusLine": { "type": "command", "command": "node \"$HOME/.claude/statusline/statusline.mjs\"", "padding": 0 },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/typecheck.mjs\"", "timeout": 120, "statusMessage": "Typechecking..." }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__plugin_vercel_vercel__deploy_to_vercel",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/deploy-watch.mjs\"", "timeout": 15, "statusMessage": "Checking for deploy..." }
        ]
      }
    ]
  }
}
